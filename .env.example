# Copy to .env (never commit it) or set as environment variables / Container App settings.
# --- Microsoft Foundry project (Entra ID auth: `az login` locally, managed identity in Azure) ---
FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
FOUNDRY_MODEL=<model-deployment-name>
# --- or an Azure OpenAI resource ---
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=<deployment-name>
# AZURE_OPENAI_API_KEY=<key>          # optional; omit to use Entra ID
# --- tuning (optional) ---
# INSIGHT_LLM=off                     # force deterministic templates
# INSIGHT_LLM_ATTEMPTS=2              # PersonaAgent retries after verifier feedback
# INSIGHT_LLM_TIMEOUT=25              # seconds per model call
# INSIGHT_LLM_BUDGET_S=45             # max wait per HTTP request before unfinished items keep template text
